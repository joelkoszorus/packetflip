{
  "name": "packet-flip",
  "private": true,
  "version": "0.1.0",
  "description": "A gamified 3D network simulation sandbox: play as a network engineer.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "secrets:check": "node scripts/check-secrets.mjs --all",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "preact": "11.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
